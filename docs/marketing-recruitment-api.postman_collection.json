{
  "info": {
    "name": "ALEF DELTA Public Recruitment API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "https://erp-api.alefdelta.com/api/public/recruitment" }],
  "item": [
    { "name": "List Active Vacancies", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/vacancies" } },
    { "name": "Get Vacancy", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/vacancies/1" } },
    { "name": "List Active Jobs", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/jobs" } },
    {
      "name": "Submit Application",
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"vacancy_id\": 1,\n  \"applicant_id\": \"Abebe Kebede\",\n  \"age\": 27,\n  \"sex\": \"MALE\",\n  \"education\": \"Diploma\",\n  \"experience\": \"Three years experience\",\n  \"privacy_consent\": true,\n  \"website\": \"\"\n}" },
        "url": "{{baseUrl}}/applications"
      }
    }
  ]
}
